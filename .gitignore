# TouchDesigner auto-saves and temp files
# TD backups are named like main.1.toe, main.2.toe, ... (digit before the extension)
*.[0-9].toe
*.[0-9][0-9].toe
*.[0-9].tox
*.[0-9][0-9].tox
*.toeBackup
*.toxBackup
Backup/
TouchDesigner.log

# Node
node_modules/
.DS_Store

# Vite dev-server cache
.vite/

# Local Claude Code state (plans, settings, project memory)
.claude/

# Vendored TouchDesigner MCP artifact — fetched by scripts/setup-td-mcp.sh
vendor/

# Local API-key config for the in-TD generator. Never check in.
td/.unicorner_config.json

# Per-scene event log written by the in-TD generator (every generate attempt
# appends a JSONL record: prompt, raw response, outcome, error, etc.).
# Useful for debugging model output drift; not for sharing.
td/.unicorner_log/
